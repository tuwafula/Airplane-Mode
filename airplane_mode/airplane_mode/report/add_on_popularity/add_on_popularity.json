 "prepared_report": 0,
 "query": "SELECT \n    child.item as add_on_type, \n    COUNT(*) as sold_count\nFROM \n    `tabAirplane Ticket Add-on Item` as child\nJOIN\n    `tabAirplane Ticket` as parent ON child.parent = parent.name\nWHERE\n    parent.docstatus = 1\nGROUP BY\n    child.item\nORDER BY\n    sold_count DESC\n\n\n",
 "ref_doctype": "Airplane Ticket",
